# Personal CLI runner. Never expose this port through a tunnel.
PERSONAL_BIND=127.0.0.1
PERSONAL_PORT=4311
SHARED_BASE_URL=http://127.0.0.1:4310
# Your own app user id (user_...). Only this user may log in through the personal entry.
PERSONAL_OWNER_USER_ID=
CLAUDE_BIN=claude
CLAUDE_MODEL=sonnet
ALLOW_CLAUDE_EXECUTION=false
# Set to true only after the A01 conclusion on #25 (your own PC and account, no relaying). Without it the runner stays fake.
CLAUDE_TERMS_ACK=false
# Live Routes lookups per job in mixed/live mode (1-6, default 6). Cannot be raised above 6.
AI_MAX_LIVE_LEGS=6
# true prints one metrics line per job (timings and counts only, never prompts or content).
AI_LOG_METRICS=false
AI_CONCURRENCY=1
AI_QUEUE_LIMIT=8
AI_TIMEOUT_SECONDS=300
CLI_TIMEOUT_SECONDS=120
AI_SAVE_TIMEOUT_SECONDS=60
# Job journal (metadata only, never prompts or tokens). Default: .local/ai-local/jobs (git-ignored).
AI_JOB_DIR=
# Do not place Claude OAuth credentials or API keys here.
