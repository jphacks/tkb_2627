# Personal CLI runner. Never expose this port through a tunnel.
PERSONAL_BIND=127.0.0.1
PERSONAL_PORT=4311
SHARED_BASE_URL=http://127.0.0.1:4310
CLAUDE_BIN=claude
CLAUDE_MODEL=sonnet
ALLOW_CLAUDE_EXECUTION=false
AI_CONCURRENCY=1
AI_QUEUE_LIMIT=8
AI_TIMEOUT_SECONDS=300
CLI_TIMEOUT_SECONDS=120
# Do not place Claude OAuth credentials or API keys here.
