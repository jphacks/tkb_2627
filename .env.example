# Template only. App reads these after M1 implements the runtime.
SHARED_BIND=127.0.0.1
SHARED_PORT=4310
DATABASE_PATH=./data/travel.sqlite
# fixture (default) | mixed (fixture places + live Google routes) | live. mixed/live refuse to start without GOOGLE_MAPS_SERVER_KEY.
PROVIDER_MODE=fixture
# Server-side key; never commit a value. Leave empty in fixture mode.
GOOGLE_MAPS_SERVER_KEY=
PUBLIC_MAPS_BROWSER_KEY=
SESSION_SECRET=
SESSION_TTL_DAYS=7
PUBLIC_ORIGIN=
# Set to loopback only when a tunnel/proxy on this machine forwards requests (never true).
TRUST_PROXY=
# Public demo (docs/deployment.md): https tunnel URL, SESSION_SECRET >= 32 chars, TRUST_PROXY=loopback.
