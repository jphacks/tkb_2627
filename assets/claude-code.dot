digraph D {
graph [rankdir=LR,bgcolor="transparent",pad="0.35",nodesep="0.65",ranksep="1.3",splines=spline,outputorder=edgesfirst]; node [shape=plain,fontname="Noto Sans CJK JP"]; edge [fontname="Noto Sans CJK JP",fontsize=11,arrowsize=0.75,penwidth=1.3];
"GenerationInput" [label=<<TABLE BORDER="1" COLOR="#75618f" CELLBORDER="0" CELLSPACING="0" CELLPADDING="9" BGCOLOR="white"><TR><TD BGCOLOR="#f0eaf8"><FONT POINT-SIZE="10">«type»</FONT><BR/><B>GenerationInput</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11">schemaVersion: 1</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11">constraints: TripConstraints</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11">allowedPlaceIds: string[]</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11">facts: PermittedFact[]</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11">fixedActivities: ActivityRef[]</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11">instructions: string</FONT></TD></TR></TABLE>>,URL="#type=GenerationInput"];
"ClaudeRunner" [label=<<TABLE BORDER="1" COLOR="#75618f" CELLBORDER="0" CELLSPACING="0" CELLPADDING="9" BGCOLOR="white"><TR><TD BGCOLOR="#f0eaf8"><FONT POINT-SIZE="10">«class»</FONT><BR/><B>ClaudeRunner</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11">run(input, AbortSignal): Promise&lt;RunnerR<BR/>esult&gt;</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11">spawn(fixedExe, fixedArgs, shell=false)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11">stdin.write(prompt)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11">limit stdout / timeout / cancel</FONT></TD></TR></TABLE>>,URL="#type=ClaudeRunner"];
"RunnerResult" [label=<<TABLE BORDER="1" COLOR="#75618f" CELLBORDER="0" CELLSPACING="0" CELLPADDING="9" BGCOLOR="white"><TR><TD BGCOLOR="#f0eaf8"><FONT POINT-SIZE="10">«type»</FONT><BR/><B>RunnerResult</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11">exitCode: number</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11">envelope: unknown</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11">durationMs: number</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11">error?: SafeError</FONT></TD></TR></TABLE>>,URL="#type=RunnerResult"];
"BlueprintParser" [label=<<TABLE BORDER="1" COLOR="#75618f" CELLBORDER="0" CELLSPACING="0" CELLPADDING="9" BGCOLOR="white"><TR><TD BGCOLOR="#f0eaf8"><FONT POINT-SIZE="10">«function»</FONT><BR/><B>BlueprintParser</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11">parse(envelope): PlanBlueprint</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11">verify structured_output</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11">validate JSON Schema</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11">reject unknown place IDs</FONT></TD></TR></TABLE>>,URL="#type=BlueprintParser"];
"PlanBlueprint" [label=<<TABLE BORDER="1" COLOR="#75618f" CELLBORDER="0" CELLSPACING="0" CELLPADDING="9" BGCOLOR="white"><TR><TD BGCOLOR="#f0eaf8"><FONT POINT-SIZE="10">«type»</FONT><BR/><B>PlanBlueprint</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11">schemaVersion: 1</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11">candidates: CandidateBlueprint[]</FONT></TD></TR></TABLE>>,URL="#type=PlanBlueprint"];
"SafeError" [label=<<TABLE BORDER="1" COLOR="#75618f" CELLBORDER="0" CELLSPACING="0" CELLPADDING="9" BGCOLOR="white"><TR><TD BGCOLOR="#f0eaf8"><FONT POINT-SIZE="10">«type»</FONT><BR/><B>SafeError</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11">code: CLI_* | INVALID_OUTPUT</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11">message: string</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11">retryable: boolean</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11">requestId: string</FONT></TD></TR></TABLE>>,URL="#type=SafeError"];
"CandidateBlueprint" [label=<<TABLE BORDER="1" COLOR="#75618f" CELLBORDER="0" CELLSPACING="0" CELLPADDING="9" BGCOLOR="white"><TR><TD BGCOLOR="#f0eaf8"><FONT POINT-SIZE="10">«type»</FONT><BR/><B>CandidateBlueprint</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11">candidateId: string</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11">activityOrder: string[]</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11">reasons: string[]</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11">warnings: string[]</FONT></TD></TR></TABLE>>,URL="#type=CandidateBlueprint"];
"GenerationInput" -> "ClaudeRunner" [label="run(input, signal)",color="#705888"];
"ClaudeRunner" -> "RunnerResult" [label="Promise<RunnerResult>",color="#705888"];
"RunnerResult" -> "BlueprintParser" [label="envelope: unknown",color="#705888"];
"BlueprintParser" -> "PlanBlueprint" [label="検証済みの候補型",color="#705888"];
"ClaudeRunner" -> "SafeError" [label="process失敗",color="#705888"];
"BlueprintParser" -> "SafeError" [label="Schema不一致",color="#705888"];
"PlanBlueprint" -> "CandidateBlueprint" [label="candidates / 候補の配列",color="#705888"];
}