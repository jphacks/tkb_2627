digraph D {
graph [rankdir=LR,bgcolor="transparent",pad="0.35",nodesep="0.65",ranksep="1.3",splines=spline,outputorder=edgesfirst]; node [shape=plain,fontname="Noto Sans CJK JP"]; edge [fontname="Noto Sans CJK JP",fontsize=11,arrowsize=0.75,penwidth=1.3];
"users" [label=<<TABLE BORDER="1" COLOR="#5d7790" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8" BGCOLOR="white"><TR><TD BGCOLOR="#e9f0f6"><FONT POINT-SIZE="10">«table»</FONT><BR/><B>users</B><BR/>利用者</TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">id PK</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">login_id UNIQUE</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">password_hash</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">display_name</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">created_at</FONT></TD></TR></TABLE>>,URL="#table=users"];
"sessions" [label=<<TABLE BORDER="1" COLOR="#5d7790" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8" BGCOLOR="white"><TR><TD BGCOLOR="#e9f0f6"><FONT POINT-SIZE="10">«table»</FONT><BR/><B>sessions</B><BR/>アプリセッション</TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">id_hash PK</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">user_id FK</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">expires_at</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">revoked_at</FONT></TD></TR></TABLE>>,URL="#table=sessions"];
"trips" [label=<<TABLE BORDER="1" COLOR="#5d7790" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8" BGCOLOR="white"><TR><TD BGCOLOR="#e9f0f6"><FONT POINT-SIZE="10">«table»</FONT><BR/><B>trips</B><BR/>旅程の現在版</TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">id PK</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">owner_id FK</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">schema_version</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">title</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">revision</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">constraints_json</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">days_json</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">places_json</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">warnings_json</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">validation_state</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">created_at</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">updated_at</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">deleted_at</FONT></TD></TR></TABLE>>,URL="#table=trips"];
"trip_versions" [label=<<TABLE BORDER="1" COLOR="#5d7790" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8" BGCOLOR="white"><TR><TD BGCOLOR="#e9f0f6"><FONT POINT-SIZE="10">«table»</FONT><BR/><B>trip_versions</B><BR/>旅程履歴</TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">trip_id FK</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">revision</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">document_json</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">created_at</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">UNIQUE(trip_id, revision)</FONT></TD></TR></TABLE>>,URL="#table=trip_versions"];
"plan_batches" [label=<<TABLE BORDER="1" COLOR="#5d7790" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8" BGCOLOR="white"><TR><TD BGCOLOR="#e9f0f6"><FONT POINT-SIZE="10">«table»</FONT><BR/><B>plan_batches</B><BR/>生成候補群</TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">id PK</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">owner_id FK</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">base_trip_id? FK</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">base_revision?</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">generation_id</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">schema_version</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">candidates_json</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">places_json</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">created_at</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">UNIQUE(owner_id,generation_id)</FONT></TD></TR></TABLE>>,URL="#table=plan_batches"];
"groups" [label=<<TABLE BORDER="1" COLOR="#5d7790" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8" BGCOLOR="white"><TR><TD BGCOLOR="#e9f0f6"><FONT POINT-SIZE="10">«table»</FONT><BR/><B>groups</B><BR/>共有グループ</TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">id PK</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">owner_id FK</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">name</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">created_at</FONT></TD></TR></TABLE>>,URL="#table=groups"];
"group_members" [label=<<TABLE BORDER="1" COLOR="#5d7790" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8" BGCOLOR="white"><TR><TD BGCOLOR="#e9f0f6"><FONT POINT-SIZE="10">«table»</FONT><BR/><B>group_members</B><BR/>現在の所属</TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">group_id FK</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">user_id FK</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">role</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">joined_at</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">PRIMARY KEY(group_id,user_id)</FONT></TD></TR></TABLE>>,URL="#table=group_members"];
"group_invites" [label=<<TABLE BORDER="1" COLOR="#5d7790" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8" BGCOLOR="white"><TR><TD BGCOLOR="#e9f0f6"><FONT POINT-SIZE="10">«table»</FONT><BR/><B>group_invites</B><BR/>グループ招待</TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">token_hash PK</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">group_id FK</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">invitee_id? FK</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">expires_at</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">consumed_at</FONT></TD></TR></TABLE>>,URL="#table=group_invites"];
"posts" [label=<<TABLE BORDER="1" COLOR="#5d7790" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8" BGCOLOR="white"><TR><TD BGCOLOR="#e9f0f6"><FONT POINT-SIZE="10">«table»</FONT><BR/><B>posts</B><BR/>SNS投稿</TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">id PK</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">owner_id FK</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">source_trip_id? FK</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">source_revision</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">snapshot_id FK</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">visibility</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">group_id? FK</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">revision</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">story</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">deleted_at</FONT></TD></TR></TABLE>>,URL="#table=posts"];
"post_snapshots" [label=<<TABLE BORDER="1" COLOR="#5d7790" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8" BGCOLOR="white"><TR><TD BGCOLOR="#e9f0f6"><FONT POINT-SIZE="10">«table»</FONT><BR/><B>post_snapshots</B><BR/>公開用固定コピー</TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">id PK</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">document_json</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">redaction_version</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">created_at</FONT></TD></TR></TABLE>>,URL="#table=post_snapshots"];
"post_previews" [label=<<TABLE BORDER="1" COLOR="#5d7790" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8" BGCOLOR="white"><TR><TD BGCOLOR="#e9f0f6"><FONT POINT-SIZE="10">«table»</FONT><BR/><B>post_previews</B><BR/>投稿前プレビュー</TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">token_hash PK</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">owner_id FK</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">trip_id FK</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">source_revision</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">visibility</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">group_id? FK</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">story</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">snapshot_json</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">expires_at</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">consumed_at?</FONT></TD></TR></TABLE>>,URL="#table=post_previews"];
"exports" [label=<<TABLE BORDER="1" COLOR="#5d7790" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8" BGCOLOR="white"><TR><TD BGCOLOR="#e9f0f6"><FONT POINT-SIZE="10">«table»</FONT><BR/><B>exports</B><BR/>しおり出力物</TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">id PK</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">owner_id FK</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">trip_id FK</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">source_revision</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">file_path</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">status</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">expires_at</FONT></TD></TR></TABLE>>,URL="#table=exports"];
"operation_keys" [label=<<TABLE BORDER="1" COLOR="#5d7790" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8" BGCOLOR="white"><TR><TD BGCOLOR="#e9f0f6"><FONT POINT-SIZE="10">«table»</FONT><BR/><B>operation_keys</B><BR/>重複更新の防止</TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">owner_id FK</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">action</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">key_hash</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">request_hash</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">result_id</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">expires_at</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">UNIQUE(owner_id,action,key_hash)</FONT></TD></TR></TABLE>>,URL="#table=operation_keys"];
