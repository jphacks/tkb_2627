digraph D {
graph [rankdir=LR,bgcolor="transparent",pad="0.35",nodesep="0.65",ranksep="1.3",splines=spline,outputorder=edgesfirst]; node [shape=plain,fontname="Noto Sans CJK JP"]; edge [fontname="Noto Sans CJK JP",fontsize=11,arrowsize=0.75,penwidth=1.3];
"users" [label=<<TABLE BORDER="1" COLOR="#5d7790" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8" BGCOLOR="white"><TR><TD BGCOLOR="#e9f0f6"><B>users</B><BR/>利用者</TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11">id PK</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11">login_id UNIQUE</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11">password_hash</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11">display_name</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11">created_at</FONT></TD></TR></TABLE>>,URL="#table=users"];
"trips" [label=<<TABLE BORDER="1" COLOR="#5d7790" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8" BGCOLOR="white"><TR><TD BGCOLOR="#e9f0f6"><B>trips</B><BR/>旅程の現在版</TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11">id PK</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11">owner_id FK</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11">schema_version</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11">title</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11">revision</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11">constraints_json</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11">days_json</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11">places_json</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11">warnings_json</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11">validation_state</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11">created_at</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11">updated_at</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11">deleted_at</FONT></TD></TR></TABLE>>,URL="#table=trips"];
"groups" [label=<<TABLE BORDER="1" COLOR="#5d7790" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8" BGCOLOR="white"><TR><TD BGCOLOR="#e9f0f6"><B>groups</B><BR/>共有グループ</TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11">id PK</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11">owner_id FK</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11">name</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11">created_at</FONT></TD></TR></TABLE>>,URL="#table=groups"];
"group_members" [label=<<TABLE BORDER="1" COLOR="#5d7790" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8" BGCOLOR="white"><TR><TD BGCOLOR="#e9f0f6"><B>group_members</B><BR/>現在の所属</TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11">group_id FK</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11">user_id FK</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11">role</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11">joined_at</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11">PRIMARY KEY(group_id,user_id)</FONT></TD></TR></TABLE>>,URL="#table=group_members"];
"posts" [label=<<TABLE BORDER="1" COLOR="#5d7790" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8" BGCOLOR="white"><TR><TD BGCOLOR="#e9f0f6"><B>posts</B><BR/>SNS投稿</TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11">id PK</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11">owner_id FK</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11">source_trip_id? FK</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11">source_revision</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11">snapshot_id FK</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11">visibility</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11">group_id? FK</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11">revision</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11">story</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11">deleted_at</FONT></TD></TR></TABLE>>,URL="#table=posts"];
"post_snapshots" [label=<<TABLE BORDER="1" COLOR="#5d7790" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8" BGCOLOR="white"><TR><TD BGCOLOR="#e9f0f6"><B>post_snapshots</B><BR/>公開用固定コピー</TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11">id PK</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11">document_json</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11">redaction_version</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11">created_at</FONT></TD></TR></TABLE>>,URL="#table=post_snapshots"];
"users" -> "trips" [arrowhead=none,taillabel="1",headlabel="0..*",label="trips.owner_id",fontsize=10];
"users" -> "posts" [arrowhead=none,taillabel="1",headlabel="0..*",label="posts.owner_id",fontsize=10];
"trips" -> "posts" [arrowhead=none,taillabel="0..1",headlabel="0..*",label="source_trip_id",fontsize=10];
"posts" -> "post_snapshots" [arrowhead=none,taillabel="1",headlabel="1",label="snapshot_id",fontsize=10];
"groups" -> "posts" [arrowhead=none,taillabel="0..1",headlabel="0..*",label="posts.group_id",fontsize=10];
"groups" -> "group_members" [arrowhead=none,taillabel="1",headlabel="1..*",label="group_members.group_id",fontsize=10];
"users" -> "group_members" [arrowhead=none,taillabel="1",headlabel="0..*",label="group_members.user_id",fontsize=10];
}