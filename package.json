{
  "name": "tkb-2627",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "check": "node scripts/check-plan.mjs && node scripts/check-model.mjs",
    "test": "node --test tests/*.test.mjs tests/contracts/*.test.mjs",
    "doctor": "node scripts/doctor.mjs",
    "guide": "node scripts/render-dashboard.mjs",
    "progress": "node scripts/github-sync.mjs snapshot --repo jphacks/tkb_2627 && node scripts/render-dashboard.mjs --publish",
    "master": "node scripts/make-master.mjs",
    "check:repo": "node scripts/check-repo.mjs",
    "setup": "node scripts/app-setup.mjs",
    "db:migrate": "tsx packages/db/src/cli.ts migrate",
    "user:create": "node scripts/create-user.mjs",
    "db:backup": "node scripts/backup.mjs",
    "db:restore": "node scripts/restore.mjs",
    "dev": "concurrently -k -n shared,local,web -c blue,magenta,green \"npm:dev:shared\" \"npm:dev:local\" \"npm:dev:web\"",
    "dev:shared": "tsx watch apps/server/src/main.ts",
    "dev:local": "tsx watch apps/ai-local/src/main.ts",
    "dev:web": "npm run dev -w @tkb/web",
    "build": "npm run typecheck && npm run build -w @tkb/web",
    "start:shared": "tsx apps/server/src/main.ts",
    "serve:demo": "node scripts/serve-demo.mjs",
    "start:local": "tsx apps/ai-local/src/main.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:unit": "vitest run",
    "test:all": "npm run check && npm run check:secrets && npm run lint && npm test && npm run typecheck && npm run test:unit",
    "check:secrets": "node scripts/check.mjs",
    "lint": "tsc -p tsconfig.json --noEmit --noUnusedLocals --noUnusedParameters && node scripts/lint-mjs.mjs"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.0.0",
    "concurrently": "^10.0.6",
    "jsdom": "^29.1.1",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vitest": "^5.0.5"
  }
}
